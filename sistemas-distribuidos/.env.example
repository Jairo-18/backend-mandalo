# Environment de la app Compose de Dokploy (gRPC + consumers + Kafka UI), o
# sistemas-distribuidos/.env para correr local. Solo en local (perfil "local",
# con el API incluido) hay que agregar además TODO el .env.development.

# DB de DEV (nunca la de prod)
DB_HOST=
DB_PORT=
DB_DATABASE=mandalo_dev
DB_USERNAME=
DB_PASSWORD=
DB_SSL=false

# Kafka UI (login)
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=
